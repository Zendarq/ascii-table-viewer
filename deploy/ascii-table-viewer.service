[Unit]
Description=ASCII Table Viewer (gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/ascii-table-viewer
Environment="PATH=/opt/ascii-table-viewer/venv/bin"
ExecStart=/opt/ascii-table-viewer/venv/bin/gunicorn -w 2 -b 127.0.0.1:8000 app:app
Restart=always

[Install]
WantedBy=multi-user.target
